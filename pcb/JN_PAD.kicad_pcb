    (property "Value" "MountingHole" (at 0 3.5 0) (layer "F.Fab") (effects (font (size 1 1))))
    (pad "" np_thru_hole circle (at 0 0) (size 4.4 4.4) (drill 2.2) (layers "*.Cu" "*.Mask"))
  )
  ; Bottom-right
  (footprint "MountingHole:MountingHole_2.2mm_M2" (layer "F.Cu") (uuid "mh-br")
    (at 72.7 123.5)
    (property "Reference" "H4" (at 0 -3.5 0) (layer "F.SilkS") (effects (font (size 1 1))))
    (property "Value" "MountingHole" (at 0 3.5 0) (layer "F.Fab") (effects (font (size 1 1))))
    (pad "" np_thru_hole circle (at 0 0) (size 4.4 4.4) (drill 2.2) (layers "*.Cu" "*.Mask"))
  )

  ; ── Switch footprints (MX_Hotswap-1U, flipped to B.Cu) ───────────────────
  ; All switches are flipped (layer "B.Cu") so hotswap socket pads are on B.Cu
  ; and switches insert from the top (F.Cu side).
  ; COL2ROW diode orientation:
  ;   SW pad "1" → COL net
  ;   SW pad "2" → SW#_A intermediate net (= diode anode)
  ;   Diode A pad → SW#_A intermediate net
  ;   Diode K pad → ROW net
  ; Switch pin holes: 1.5mm drill (standard MX contact pin diameter)

  ; SW1 — ROW0, COL0
  (footprint "MX_Hotswap:MX_Hotswap-1U" (layer "B.Cu") (uuid "sw1")
    (at 9.525 9.525) (mirror yes)
    (property "Reference" "SW1" (at 0 -5 0) (layer "B.SilkS") (effects (font (size 1 1)) (justify mirror)))
    (property "Value" "SW_Push" (at 0 5 0) (layer "B.Fab") (effects (font (size 1 1)) (justify mirror)))
    (property "Footprint" "MX_Hotswap:MX_Hotswap-1U" (at 0 0 0) (layer "B.Fab") (effects (font (size 1 1)) hide))
    (pad "1" thru_hole circle (at -2.54 -5.08) (size 3.0 3.0) (drill 1.5) (layers "*.Cu" "*.Mask") (net 1 "COL0"))
    (pad "2" thru_hole circle (at 2.54 -5.08) (size 3.0 3.0) (drill 1.5) (layers "*.Cu" "*.Mask") (net 10 "SW1_A"))
